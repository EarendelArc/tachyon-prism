{
    "name": "tachyon-prism",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "tauri dev",
        "web:dev": "vite --configLoader native --host 127.0.0.1 --port 1420",
        "web:build": "tsc && vite build --configLoader runner && npm run verify:production-bundle",
        "build": "tauri build --features custom-protocol",
        "build:release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-release.ps1",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:core-contract": "vitest run --config vitest.contract.config.ts --reporter=verbose",
        "test:ui": "vite build --configLoader runner --mode ui-smoke && python scripts/prism_ui_smoke.py --port 0",
        "test:ui:twice": "vite build --configLoader runner --mode ui-smoke && python scripts/prism_ui_smoke_twice.py",
        "test:native-window": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prism_native_window_smoke.ps1 -Level L1",
        "test:native-input": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prism_native_window_smoke.ps1 -Level L2",
        "test:native-window:strict": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prism_native_window_smoke.ps1 -Level Strict",
        "verify:production-bundle": "python scripts/verify_production_bundle.py --dist dist"
    },
    "dependencies": {
        "@tauri-apps/api": "2.11.0",
        "react": "19.2.7",
        "react-dom": "19.2.7"
    },
    "devDependencies": {
        "@tauri-apps/cli": "2.11.2",
        "@types/node": "^25.9.3",
        "@types/react": "19.2.16",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "typescript": "6.0.3",
        "vite": "8.0.16",
        "vitest": "^4.1.8"
    }
}
